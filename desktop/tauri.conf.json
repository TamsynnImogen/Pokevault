{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Pokemon Vault",
  "version": "0.1.0",
  "identifier": "org.pokemonvault.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Universal Pokemon Vault",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
