{
  "name": "universal-pokemon-vault-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src index.html package.json package-lock.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check src index.html package.json package-lock.json tsconfig.json vite.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.4.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "jsdom": "^27.1.0",
    "prettier": "3.6.2"
  }
}
